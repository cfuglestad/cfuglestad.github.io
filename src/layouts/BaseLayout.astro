---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'profile';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-image.svg',
  type = 'website',
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Connor Fuglestad" />
    <meta name="theme-color" content="#312e28" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Connor Fuglestad" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta
      property="og:image:alt"
      content="Connor Fuglestad — healthcare AI, applied data science, and analytics engineering"
    />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta
      name="twitter:image:alt"
      content="Connor Fuglestad — healthcare AI, applied data science, and analytics engineering"
    />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Connor Fuglestad",
      "url": "https://cfuglestad.github.io",
      "jobTitle": "Lead, Analytics & Insights",
      "worksFor": {
        "@type": "Organization",
        "name": "Vizient, Inc."
      },
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "University of Wisconsin–Madison"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "University of Washington"
        }
      ],
      "knowsAbout": [
        "Healthcare AI",
        "Natural Language Processing",
        "Applied Data Science",
        "Analytics Engineering"
      ],
      "sameAs": [
        "https://github.com/cfuglestad",
        "https://www.linkedin.com/in/connor-fuglestad"
      ]
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
