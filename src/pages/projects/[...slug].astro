---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const categoryLabel = {
  'case-study': 'Case Study',
  'coursework': 'Coursework',
  'research': 'Research',
}[project.data.category];
---
<BaseLayout
  title={`${project.data.title} | Connor Fuglestad`}
  description={project.data.description}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <article class="project-page shell">
      <div class="project-page-meta">
        <span class="kicker">{categoryLabel}{project.data.course ? ` · ${project.data.course}` : ''}</span>
        <time datetime={project.data.date.toISOString().split('T')[0]}>
          {project.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
        </time>
      </div>

      <h1>{project.data.title}</h1>
      <p class="project-page-description">{project.data.description}</p>

      <ul class="tag-list" aria-label="Technologies used">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      <div class="project-page-content">
        <Content />
      </div>

      <footer class="project-page-footer">
        {project.data.demo && (
          <a class="button primary" href={project.data.demo} target="_blank" rel="noreferrer">
            Live demo <span aria-hidden="true">→</span>
          </a>
        )}
        {project.data.github && (
          <a class="button secondary" href={project.data.github} target="_blank" rel="noreferrer">
            View source on GitHub <span aria-hidden="true">→</span>
          </a>
        )}
        <a class="text-link" href="/projects/">← All projects</a>
      </footer>
    </article>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <p>© {new Date().getFullYear()} Connor Fuglestad</p>
      <p>Built with Astro. Hosted on GitHub Pages.</p>
    </div>
  </footer>
</BaseLayout>
