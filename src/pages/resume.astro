---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Resume | Connor Fuglestad"
  description="View or download Connor Fuglestad's data science resume."
>
  <Header />

  <main id="main-content" class="resume-placeholder shell" tabindex="-1">
    <p class="kicker">Resume</p>
    <h1>Connor Fuglestad</h1>
    <p class="resume-lede">
      Applied data scientist and analytics engineering leader focused on
      healthcare AI, natural language technology, and scalable data systems.
    </p>

    <div class="hero-actions">
      <a
        class="button primary"
        href="/resume/Fuglestad_resume_2026_ds.pdf"
        target="_blank"
        rel="noreferrer"
      >
        View resume
      </a>

      <a
        class="button secondary"
        href="/resume/Fuglestad_resume_2026_ds.pdf"
        download
      >
        Download PDF
      </a>
    </div>

    <p class="resume-return">
      <a class="text-link" href="/">Return home <span aria-hidden="true">→</span></a>
    </p>
  </main>
</BaseLayout>