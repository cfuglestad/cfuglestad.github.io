---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import '../styles/global.css';

const focusAreas = [
  {
    title: 'Healthcare AI',
    body: 'NLP and machine learning applied to clinical and operational problems. Interested in retrieval, summarization, and evaluation of healthcare evidence.'
  },
  {
    title: 'Applied Data Science',
    body: 'Econometrics and statistical modeling with an emphasis on whether the measurement is valid, not just whether the pipeline runs.'
  },
  {
    title: 'Production Data Systems',
    body: 'Dimensional models, ETL pipelines, and metric layers on Databricks and PySpark. The part most researchers skip.'
  }
];

const projects = [
  {
    eyebrow: 'Flagship project',
    title: 'Healthcare Evidence Explorer',
    description: 'A planned evidence synthesis platform that will retrieve, summarize, and evaluate healthcare research with transparent citations and model-quality checks.',
    tags: ['NLP', 'RAG', 'LLM Evaluation', 'Healthcare'],
    status: 'In development'
  },
  {
    eyebrow: 'Coursework portfolio',
    title: 'Natural Language Technology',
    description: 'A growing collection of polished projects from the University of Washington certificate program, focused on language modeling, information retrieval, and evaluation.',
    tags: ['Python', 'NLP', 'Information Retrieval', 'Evaluation'],
    status: 'Beginning 2026'
  },
  {
    eyebrow: 'Professional case study',
    title: 'Scalable Healthcare Analytics Systems',
    description: 'A sanitized case study on modernizing healthcare analytics through reusable data pipelines, API-driven ingestion, dimensional models, and governed reporting layers.',
    tags: ['Databricks', 'PySpark', 'SQL', 'APIs'],
    status: 'Drafting'
  }
];
---
<BaseLayout
  title="Connor Fuglestad | Applied Data Science and Healthcare AI"
  description="Portfolio of Connor Fuglestad, an applied data scientist and analytics engineering leader focused on healthcare AI, natural language technology, and scalable data systems."
>
  <Header />

  <main id="main-content" tabindex="-1">
    <div id="top" aria-hidden="true"></div>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="kicker">Applied data science · natural language processing · healthcare AI</p>
        <h1>Building rigorous data systems and AI applications for healthcare.</h1>
        <p class="hero-lede">
          I'm Connor Fuglestad. I build analytics systems for health system clients at Vizient, mostly in Databricks and PySpark. Before that I studied econometrics at UW-Madison, and right now I'm finishing a certificate in natural language technology at the University of Washington. I like problems where statistical rigor and production engineering both matter.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#work">View selected work</a>
          <a
            class="button secondary"
            href="/resume/Fuglestad_resume_2026_ds.pdf"
            target="_blank"
            rel="noreferrer"
          >
            View resume
          </a>
        </div>
        <div class="social-row" aria-label="Professional profiles">
          <a href="https://github.com/cfuglestad" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/connor-fuglestad" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="mailto:fuglconn@gmail.com">Email</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Current focus">
        <p class="panel-label">Current focus</p>
        <p class="panel-title">Healthcare AI and natural language technology</p>
        <p>Lead, Analytics & Insights at Vizient</p>
        <p>University of Washington Certificate in Natural Language Technology, expected 2027</p>
        <div class="panel-rule"></div>
        <p class="panel-small">Omaha, Nebraska</p>
      </aside>
    </section>

    <section id="about" class="section shell reveal-section">
      <div class="section-heading">
        <p class="kicker">About</p>
        <h2>An economist who builds data systems for healthcare.</h2>
      </div>
      <div class="about-grid">
        <div class="about-copy">
          <p>
            My graduate training was in economics, focused on econometrics and statistical inference. I think that shows up in how I work: I'm more interested in whether a model is specified correctly than whether the code is clean. I've spent the past several years applying that instinct to healthcare data, and more recently to language technology and information retrieval through the UW program.
          </p>
          <p>
            At Vizient, I build the analytics layer that health system clients use for quality reporting: star schemas, API integrations, reference-file-driven dimensional models, and a lot of SQL. I also set the technical standards for how our team writes PySpark. The coursework I'm doing at UW (information retrieval, language modeling, evaluation methods) is where most of my new energy goes.
          </p>
        </div>
        <div class="focus-grid">
          {focusAreas.map((area) => (
            <article class="focus-card">
              <h3>{area.title}</h3>
              <p>{area.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="work" class="section section-alt reveal-section">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="kicker">Selected work</p>
            <h2>Projects that connect healthcare, language, and quantitative research.</h2>
          </div>
          <p class="section-note">This section is intentionally small. Each project will become a full case study as the work matures.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
      </div>
    </section>

    <section id="experience" class="section shell reveal-section">
      <div class="section-heading">
        <p class="kicker">Experience</p>
        <h2>From econometrics to analytics engineering, mostly in healthcare.</h2>
      </div>
      <div class="experience-list">
        <ExperienceItem
          role="Lead, Analytics & Insights"
          company="Vizient, Inc."
          dates="December 2025 to present"
          summary="Build analytics systems for health system clients across multiple regions. Design dimensional models, metric layers, and automated data pipelines on Databricks. Set technical standards for the team's PySpark and SQL work."
        />
        <ExperienceItem
          role="Senior Analytics Engineer"
          company="Vizient, Inc."
          dates="April 2025 to December 2025"
          summary="Migrated analytics products to Databricks and Unity Catalog. Built reusable Python ETL components and started integrating AI-assisted analysis (automated summarization, anomaly detection) into reporting workflows."
        />
        <ExperienceItem
          role="Analytics Engineer"
          company="Vizient, Inc."
          dates="November 2022 to April 2025"
          summary="Designed a reference-file-driven data architecture powering all dimensional models (40+ source files, automated Spark ingestion). Built the SQL transformation layer between raw healthcare data and governed reporting surfaces."
        />
        <ExperienceItem
          role="Analytics Consultant"
          company="University of Wisconsin Health System"
          dates="January 2022 to November 2022"
          summary="Applied econometric methods to clinical and operational data. Demand forecasting, staffing optimization, quality measurement. First time working directly with EHR data and clinical teams."
        />
        <ExperienceItem
          role="Consultant"
          company="Resolution Economics"
          dates="April 2019 to July 2020"
          summary="Built analytical datasets for economic consulting and class action litigation. Quantitative analysis and expert report writing."
        />
      </div>
    </section>

    <section class="section section-alt reveal-section">
      <div class="shell education-grid">
        <div class="section-heading">
          <p class="kicker">Education</p>
          <h2>Quantitative training with a growing focus on language technology.</h2>
        </div>
        <div class="education-list">
          <article>
            <p class="education-school">University of Washington</p>
            <h3>Certificate in Natural Language Technology</h3>
            <p>In progress, expected 2027</p>
          </article>
          <article>
            <p class="education-school">University of Wisconsin–Madison</p>
            <h3>Master of Science, Economics</h3>
            <p>Econometrics, mathematical economics, microeconomic theory, and macroeconomic theory</p>
          </article>
          <article>
            <p class="education-school">University of Wisconsin–Madison</p>
            <h3>Bachelor of Arts, Economics and German</h3>
            <p>Mathematical emphasis, graduated with distinction</p>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section reveal-section">
      <div class="shell contact-inner">
        <div>
          <p class="kicker light">Contact</p>
          <h2>Interested in healthcare AI, applied data science, or technical analytics leadership?</h2>
        </div>
        <div class="contact-actions">
          <a class="button light-button" href="mailto:fuglconn@gmail.com">Email Connor</a>
          <a class="text-link light-link" href="https://www.linkedin.com/in/connor-fuglestad" target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="shell footer-inner">
      <p>© {new Date().getFullYear()} Connor Fuglestad</p>
      <p>Built with Astro and deployed on GitHub Pages.</p>
    </div>
  </footer>
</BaseLayout>
